<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <View
        android:id="@+id/headerReserva"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#1976D2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleReserva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:text="Mis Reservas"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitleReserva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actividades que has organizado"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/titleReserva"
        app:layout_constraintTop_toBottomOf="@+id/titleReserva" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMisReservas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerReserva"
        tools:listitem="@layout/reserva_layout" />

    <ProgressBar
        android:id="@+id/pbReservas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerReserva" />

</androidx.constraintlayout.widget.ConstraintLayout>