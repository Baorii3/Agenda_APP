<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/viewUserIconBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/icon_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivUser"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="@string/usuarios_title"
            app:tint="@color/android_blue"
            app:layout_constraintStart_toStartOf="@id/viewUserIconBg"
            app:layout_constraintEnd_toEndOf="@id/viewUserIconBg"
            app:layout_constraintTop_toTopOf="@id/viewUserIconBg"
            app:layout_constraintBottom_toBottomOf="@id/viewUserIconBg" />

        <TextView
            android:id="@+id/tvUsuariName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/placeholder_user_name"
            android:textColor="@color/android_title"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/viewUserIconBg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvUsuariEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/placeholder_user_email"
            android:textColor="@color/android_desc"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvUsuariName"
            app:layout_constraintTop_toBottomOf="@id/tvUsuariName"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvUsuariRol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/success_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/placeholder_user_role"
            android:textColor="@color/success_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvUsuariName"
            app:layout_constraintTop_toBottomOf="@id/tvUsuariEmail" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
